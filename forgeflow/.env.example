# Django Settings
SECRET_KEY=django-insecure-forgeflow-dev-secret-key-change-in-production-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL Docker Container)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=forgeflow
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=127.0.0.1
DB_PORT=5434

# Use SQLite fallback (False = Real PostgreSQL)
USE_SQLITE=False
